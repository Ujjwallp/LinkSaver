<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#1E1E2E">

    <TextView
        android:id="@+id/autofill_icon_text"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="#2E2E3E"
        android:gravity="center"
        android:text="🔑"
        android:textSize="18sp"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/autofill_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LinkVault Autofill"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autofill_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username@example.com"
            android:textColor="#A0A0B0"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
